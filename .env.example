# TenderSense AI - Environment Configuration

# LLM Provider Options: "auto", "gemini", "openai", "local"
LLM_PROVIDER=auto

# Google Gemini API Key (optional - system falls back to high-accuracy deterministic engine when omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Hybrid RAG Weights (0.0 to 1.0; 0.5 balances vector and BM25 equally)
HYBRID_ALPHA=0.5
TOP_K_RETRIEVAL=5

# Guardrails
MIN_CONFIDENCE_THRESHOLD=0.35
REQUIRE_EVIDENCE=true
